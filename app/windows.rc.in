#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/radial.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Tablet Pro"
      VALUE "FileDescription", "Tablet Pro Radial"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "tabletpro_radial"
      VALUE "OriginalFilename", "tabletpro_radial.exe"
      VALUE "ProductName", "Tablet Pro Radial"
      VALUE "ProductVersion", "@PROJECT_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
